# Copia este archivo como "backend/.env" y completa los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# --- Base de datos -----------------------------------------------------------
# default  = H2 en memoria (no requiere nada mas)
# supabase = PostgreSQL en Supabase (completa las 3 variables de abajo)
SPRING_PROFILES_ACTIVE=default

# Supabase > Project > Connect > "Session pooler" (puerto 5432)
# Formato: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Formato: postgres.<id-del-proyecto>
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# --- Seguridad ---------------------------------------------------------------
# true = el BFF exige roles de aplicacion (Admin/User) asignados en Azure
BFF_ENFORCE_ROLES=false
